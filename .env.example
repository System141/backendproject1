# Copy to .env and fill in real values. .env is gitignored — never commit it.
# Required — docker compose fails to start without these.
JWT_SECRET=
POSTGRES_PASSWORD=
CORS_ORIGINS=https://yourdomain.com
FRONTEND_URL=https://yourdomain.com

# Optional
ENVIRONMENT=production
SEED_SECRET=

# Monri payment gateway
MONRI_ENV=test
MONRI_MERCHANT_KEY=
MONRI_AUTHENTICITY_TOKEN=

# Set to "true" to bypass the real Monri gateway and instantly complete credit
# purchases, for exercising the site end-to-end without real merchant keys.
# NEVER set this in production - it credits users with no real payment.
PAYMENTS_SIMULATE=

# Email notifications (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@bidmont.com
